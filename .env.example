# Copy to .env.local and fill in your MongoDB Atlas values.
# Connection string for the Atlas cluster (server-side only, never client code).
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# Database holding both environment collections (default: dtp-soma).
MONGODB_DB=dtp-soma
# Environment selector: dev writes to soma_dev_recipes, prod writes to soma_prod_recipes.
# Defaults to "prod" when NODE_ENV=production, otherwise "dev".
APP_ENV=dev
# Optional: override the collection name entirely (single collection for this process).
# MONGODB_COLLECTION=soma_dev_recipes

# Email sharing via coss.com. Run `npx coss-cli init` to get a test key
# (it writes COSS_API_KEY here). Test keys record mail without delivering.
# COSS_API_KEY=coss_test_...
# Optional sender shown on shared recipes (any address works with a test key).
# COSS_SHARE_FROM=Soma Recipes <recipes@soma.local>
